/* pages/train/train.wxss */

.img-grid { display: flex; flex-wrap: wrap; }
.img-item {
  position: relative;
  width: 148rpx;
  height: 148rpx;
  margin: 0 16rpx 20rpx 0;
}
.img-thumb {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background: #fafafa;
}
.img-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(211, 47, 47, 0.92);
  color: #fff;
  font-size: 28rpx;
}

.row-btns { display: flex; margin-top: 8rpx; }
.row-btns button { margin: 0; }
.flex1 { flex: 1; }
.row-btns .flex1 + .flex1 { margin-left: 20rpx; }

.form-row { display: flex; align-items: center; margin-bottom: 24rpx; }
.form-label { width: 150rpx; font-size: 28rpx; color: #1f2937; }
.form-input {
  flex: 1;
  background: #f4faf4;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}
.checkbox-text { margin-left: 12rpx; font-size: 26rpx; color: #6b7280; }
.form-hint { margin: 4rpx 0 20rpx 150rpx; font-size: 23rpx; color: #9ca3af; line-height: 1.6; }
.train-btn { margin-top: 8rpx; }

.status-line { display: flex; align-items: center; }
.status-badge {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #f0f4f0;
  color: #6b7280;
}
.status-badge.running { background: #fff8e1; color: #f9a825; }
.status-badge.done { background: #e8f5e9; color: #2e7d32; }
.status-badge.failed { background: #fdecea; color: #d32f2f; }
.btn-stop {
  margin-left: auto;
  background: #d32f2f;
  color: #fff;
  border-radius: 999rpx;
  font-size: 24rpx;
}
.status-tip { margin-top: 16rpx; }
.fail-text { margin-top: 16rpx; font-size: 26rpx; color: #d32f2f; line-height: 1.6; }