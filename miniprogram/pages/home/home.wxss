/* pages/home/home.wxss */

.hero {
  padding: 20rpx 8rpx 36rpx;
}
.hero-title {
  font-size: 46rpx;
  font-weight: 700;
  color: #2e7d32;
  letter-spacing: 1rpx;
}
.hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.feature-card {
  width: 48.5%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(46, 125, 50, 0.08);
  border: 1rpx solid rgba(46, 125, 50, 0.06);
}
.feature-icon {
  font-size: 52rpx;
  line-height: 1;
}
.feature-title {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}
.feature-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #9ca3af;
  line-height: 1.6;
}