/* pages/classify/classify.wxss */

.photo-btn { margin-top: 24rpx; }

.preview {
  width: 100%;
  height: 480rpx;
  border-radius: 16rpx;
  background: #fafafa;
}
.file-info {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9ca3af;
  text-align: center;
  word-break: break-all;
}

.row-btns { display: flex; margin-top: 24rpx; }
.row-btns button { margin: 0; }
.flex1 { flex: 1; }
.row-btns .flex1 + .flex1 { margin-left: 20rpx; }

.top1-box {
  display: flex;
  align-items: center;
  background: #e8f5e9;
  border-radius: 16rpx;
  padding: 24rpx;
}
.top1-name {
  flex: 1;
  margin-left: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
}
.top1-conf {
  font-size: 28rpx;
  font-weight: 700;
  color: #2e7d32;
}

.top5-list { margin-top: 24rpx; }
.top5-row { display: flex; align-items: center; margin-bottom: 18rpx; }
.top5-name {
  width: 240rpx;
  font-size: 24rpx;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.top5-row .bar { flex: 1; margin: 0 16rpx; }
.top5-pct { width: 110rpx; text-align: right; font-size: 24rpx; color: #6b7280; }

.result-tip { margin-top: 20rpx; font-size: 23rpx; color: #9ca3af; line-height: 1.7; }