/* app.wxss - 全局样式与设计规范 */

page {
  background: #f5f5f5;
  min-height: 100vh;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  color: #1f2937;
  font-size: 28rpx;
}

/* 页面容器：顶部留出状态栏空间（app.json 使用了自定义导航栏） */
.page-wrap {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 24rpx calc(env(safe-area-inset-bottom) + 40rpx);
  background: linear-gradient(180deg, #e8f5e9 0%, #f5faf5 300rpx, #f5f5f5 100%);
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(46, 125, 50, 0.08);
}
.card-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 20rpx;
}
.card-title .dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #43a047;
  margin-right: 12rpx;
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #2e7d32, #43a047);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  line-height: 2.6;
}
.btn-primary[disabled] {
  background: #a5d6a7;
  color: #fff;
}
.btn-plain {
  background: #fff;
  color: #2e7d32;
  border: 2rpx solid #2e7d32;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 2.4;
}
.btn-ghost {
  background: #e8f5e9;
  color: #2e7d32;
  border: 1rpx dashed #81c784;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 2.6;
}
button::after { border: none; }

/* 文本与标签 */
.tag {
  display: inline-block;
  background: #2e7d32;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.muted { color: #6b7280; font-size: 26rpx; line-height: 1.8; }
.empty {
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
  padding: 48rpx 0;
  line-height: 1.8;
}

/* 置信度条 */
.bar {
  height: 12rpx;
  background: #f0f4f0;
  border-radius: 999rpx;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #66bb6a, #43a047);
}